---

---

<section
  class="relative bg-slate-900 text-white overflow-hidden min-h-[85vh] flex items-center"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-blue-900/40 to-slate-900 z-0"
  >
  </div>

  <div
    class="container mx-auto px-6 relative z-10 max-w-6xl py-20 grid md:grid-cols-2 gap-12 items-center"
  >
    <div>
      <span
        class="text-blue-400 font-semibold tracking-wider uppercase text-sm block mb-3"
        >Soporte Técnico Profesional</span
      >
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        Soluciones Rápidas para tus <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400"
          >Equipos y Redes</span
        >
      </h1>
      <p class="text-lg text-slate-300 mb-8 max-w-lg">
        Reparación de computadoras, optimización de sistemas y mantenimiento de
        redes locales. Servicio rápido a domicilio y empresas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#contacto"
          class="inline-flex justify-center items-center px-6 py-3 font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition duration-200 shadow-lg shadow-blue-600/30"
        >
          Solicitar Soporte
        </a>
        <a
          href="#servicios"
          class="inline-flex justify-center items-center px-6 py-3 border border-slate-700 font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition duration-200"
        >
          Ver Servicios
        </a>
      </div>
    </div>

    <div class="hidden md:flex justify-center">
      <div
        class="relative w-full max-w-md bg-slate-800/80 backdrop-blur-md rounded-2xl border border-slate-700 p-8 shadow-2xl"
      >
        <!-- Elemento visual temático de tecnología -->
        <div class="flex items-center gap-4 mb-8 border-b border-slate-700 pb-6">
          <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 text-xl">✓</div>
          <div>
            <div class="text-white font-bold">Estado de los Sistemas</div>
            <div class="text-green-400 text-sm">Operando al 100%</div>
          </div>
        </div>
        <div class="space-y-5">
          <div>
            <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Rendimiento de Red</span> <span>98%</span></div>
            <div class="h-2 bg-slate-700 rounded-full overflow-hidden"><div class="h-full bg-blue-500 w-[98%] animate-pulse"></div></div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Seguridad Firewall</span> <span>Activa</span></div>
            <div class="h-2 bg-slate-700 rounded-full overflow-hidden"><div class="h-full bg-indigo-500 w-full animate-pulse"></div></div>
          </div>
          <p class="text-xs text-slate-400 mt-6 text-center pt-4">Monitoreo y optimización en tiempo real.</p>
        </div>
      </div>
    </div>
  </div>
</section>
