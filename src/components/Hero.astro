---
---

<section class="relative min-h-screen pt-32 pb-20 flex items-center overflow-hidden bg-pc-dark border-b border-white/5">
  
  <!-- Cyber Background Grid -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
  <div class="absolute inset-0 bg-pc-dark/60 pointer-events-none"></div>
  
  <!-- Glowing orbs -->
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-pc-cyan/20 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-pc-indigo/20 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div class="reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-pc-cyan/10 border border-pc-cyan/30 text-pc-cyan font-mono text-xs tracking-widest uppercase mb-6 glow-border">
          <span class="w-2 h-2 rounded-full bg-pc-cyan animate-pulse"></span>
          Sistema Operativo
        </div>
        
        <h1 class="font-mono text-5xl md:text-7xl font-bold text-white mb-6 leading-tight tracking-tight">
          Soporte IT de <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-pc-cyan to-pc-indigo">Alto Rendimiento</span>
        </h1>
        
        <p class="font-sans text-pc-muted text-lg mb-10 max-w-xl leading-relaxed">
          Reparación, optimización y mantenimiento de equipos informáticos. Recuperamos tu hardware y blindamos tus datos con precisión militar.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contacto" class="flex items-center justify-center gap-2 bg-pc-cyan text-pc-dark px-8 py-4 rounded-sm font-mono font-bold tracking-wide hover:bg-white transition-colors duration-300">
            INICIAR_DIAGNÓSTICO
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="#servicios" class="flex items-center justify-center gap-2 bg-transparent border border-white/20 text-white px-8 py-4 rounded-sm font-mono font-bold tracking-wide hover:border-pc-cyan hover:text-pc-cyan transition-colors duration-300 glass-panel">
            VER_SERVICIOS
          </a>
        </div>
      </div>

      <div class="reveal delay-200 relative hidden lg:block">
        <!-- Floating Cyber Container -->
        <div class="glass-panel p-2 rounded-lg transform rotate-3 hover:rotate-0 transition-transform duration-700 shadow-2xl shadow-pc-cyan/10">
          <img src="https://images.unsplash.com/photo-1591488320449-011701bb6704?q=80&w=1000&auto=format&fit=crop" alt="Motherboard" class="w-full h-auto rounded filter grayscale contrast-125 opacity-80" />
          <div class="absolute inset-0 bg-gradient-to-tr from-pc-cyan/20 to-transparent rounded pointer-events-none"></div>
          
          <!-- Floating Badge -->
          <div class="absolute -bottom-6 -left-6 glass-panel p-4 rounded border-l-2 border-l-pc-cyan flex items-center gap-4 animate-bounce">
            <div class="w-10 h-10 bg-pc-cyan/20 rounded flex items-center justify-center">
              <svg class="w-6 h-6 text-pc-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-mono text-xs text-pc-muted uppercase">Status</p>
              <p class="font-mono font-bold text-white">100% OPERATIVO</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
