---
const links = [
  { name: 'Servicios', href: '#servicios' },
  { name: 'Por qué elegirnos', href: '#features' },
  { name: 'Testimonios', href: '#testimonios' }
];
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 backdrop-blur-md bg-pc-dark/80 border-b border-white/5" id="navbar">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-sm bg-pc-cyan/10 border border-pc-cyan/30 flex items-center justify-center group-hover:bg-pc-cyan/20 transition-colors">
        <svg class="w-6 h-6 text-pc-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <span class="font-mono font-bold text-xl tracking-tight text-white group-hover:text-pc-cyan transition-colors">
        NEXUS<span class="text-pc-cyan">.IT</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex gap-8">
      {links.map(link => (
        <a href={link.href} class="text-sm font-mono font-medium text-pc-muted hover:text-pc-cyan transition-colors tracking-wide">
          {link.name}
        </a>
      ))}
    </nav>

    <!-- CTA & Mobile -->
    <div class="flex items-center gap-4">
      <a href="#contacto" class="hidden md:flex bg-pc-cyan/10 border border-pc-cyan text-pc-cyan px-6 py-2 rounded-sm font-mono text-sm font-bold tracking-wide hover:bg-pc-cyan hover:text-pc-dark transition-all duration-300 glow-border">
        _DIAGNÓSTICO
      </a>
      
      <button class="md:hidden text-pc-text hover:text-pc-cyan transition-colors" id="mobile-menu-btn" aria-label="Menu">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>