---
// Definimos los servicios en un arreglo de objetos para que sea fácil editarlos o agregar más después
const servicios = [
  {
    id: 1,
    icono: "💻",
    titulo: "Reparación de Computadoras",
    descripcion: "Diagnóstico completo, cambio de componentes defectuosos, reparación de placas base y optimización avanzada de laptops y computadoras de escritorio."
  },
  {
    id: 2,
    icono: "⚡",
    titulo: "Mantenimiento Preventivo",
    descripcion: "Limpieza interna profunda, cambio de pasta térmica y optimización de software para evitar sobrecalentamientos y prolongar la vida útil de tus equipos."
  },
  {
    id: 3,
    icono: "🌐",
    titulo: "Instalación de Redes",
    descripcion: "Diseño y estructurado de redes locales (LAN/Wi-Fi), configuración de routers, repetidores y servidores para garantizar una conexión estable y rápida."
  },
  {
    id: 4,
    icono: "🛡️",
    titulo: "Eliminación de Virus y Malware",
    descripcion: "Limpieza profunda de sistemas infectados, instalación de herramientas de seguridad y protección perimetral para resguardar tus datos valiosos."
  },
  {
    id: 5,
    icono: "💾",
    titulo: "Recuperación de Datos",
    descripcion: "Rescate de información perdida, borrada o de discos duros dañados, almacenamiento seguro y configuración de copias de seguridad automáticas."
  },
  {
    id: 6,
    icono: "🏢",
    titulo: "Soporte para Empresas",
    descripcion: "Planes de asistencia técnica mensual para oficinas y negocios locales, asegurando que tus sistemas y operaciones nunca se detengan."
  }
];
---

<section id="servicios" class="py-20 bg-white">
  <div class="container mx-auto px-6 max-w-6xl">
    
    <!-- Cabecera de la sección -->
    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
        Servicios Especializados en Tecnología
      </h2>
      <p class="text-slate-600 text-lg">
        Ofrecemos soluciones informáticas integrales con garantía y rapidez para que tus herramientas digitales funcionen siempre al 100%.
      </p>
    </div>

    <!-- Cuadrícula de Tarjetas de Servicios -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicios.map((servicio, index) => (
        <div class={`p-8 bg-slate-50 border border-slate-100 rounded-2xl hover:border-blue-500 hover:bg-white hover:shadow-xl transition-all duration-300 group reveal delay-${(index % 3) * 100}`}>
          <!-- Icono del Servicio -->
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
            {servicio.icono}
          </div>
          
          <!-- Título y Descripción -->
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors duration-300">
            {servicio.titulo}
          </h3>
          <p class="text-slate-600 leading-relaxed">
            {servicio.descripcion}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>