---
---
<section id="contacto" class="py-24 bg-white border-t border-slate-200">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <!-- Información de Contacto -->
      <div class="reveal">
        <span class="text-blue-600 font-bold tracking-wider uppercase text-sm mb-3 block">Comunícate con nosotros</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">¿Problemas con tus equipos? Lo resolvemos hoy.</h2>
        <p class="text-slate-600 text-lg mb-8">
          Déjanos tus datos y un técnico especializado se pondrá en contacto contigo en menos de 30 minutos para brindarte asesoría sin compromiso.
        </p>
        
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center text-xl">📞</div>
            <div><p class="text-sm text-slate-500">Llámanos directamente</p><p class="font-bold text-slate-900">+34 900 123 456</p></div>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center text-xl">✉️</div>
            <div><p class="text-sm text-slate-500">Escríbenos un correo</p><p class="font-bold text-slate-900">soporte@techsoluciones.com</p></div>
          </div>
        </div>
      </div>

      <!-- Formulario Moderno -->
      <div class="bg-slate-50 p-8 rounded-3xl border border-slate-200 shadow-sm reveal delay-200">
        <form id="contactForm" action="#" method="POST" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label><input type="text" required placeholder="Tu nombre" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white" /></div>
            <div><label class="block text-sm font-medium text-slate-700 mb-1">Teléfono</label><input type="tel" required placeholder="Tu teléfono" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white" /></div>
          </div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">Correo Electrónico</label><input type="email" required placeholder="tucorreo@ejemplo.com" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white" /></div>
          <div><label class="block text-sm font-medium text-slate-700 mb-1">¿En qué podemos ayudarte?</label><textarea rows="4" required placeholder="Describe brevemente el problema..." class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all bg-white resize-none"></textarea></div>
          <button id="submitBtn" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-xl transition-colors shadow-lg shadow-blue-600/20 mt-2 flex justify-center items-center gap-2">
            <span>Enviar Solicitud</span>
            <svg id="loadingIcon" class="hidden w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </button>
        </form>
        
        <!-- Mensaje de Éxito Oculto -->
        <div id="successMessage" class="hidden py-8 text-center animate-pulse">
          <div class="w-16 h-16 bg-green-100 text-green-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-4">✓</div>
          <h3 class="text-2xl font-bold text-slate-900 mb-2">¡Mensaje Enviado!</h3>
          <p class="text-slate-600">Hemos recibido tu solicitud. Un experto de nuestro equipo se pondrá en contacto contigo muy pronto.</p>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  // Lógica para interceptar el formulario y mostrar estado de carga
  const form = document.getElementById('contactForm');
  const submitBtn = document.getElementById('submitBtn');
  const loadingIcon = document.getElementById('loadingIcon');
  const successMessage = document.getElementById('successMessage');

  form?.addEventListener('submit', (e) => {
    e.preventDefault(); // Evitamos que la página se recargue
    
    // Estado de carga visual
    if (submitBtn && loadingIcon) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      loadingIcon.classList.remove('hidden');
    }

    // Simulamos que envía el formulario al servidor (Aquí puedes conectar a servicios como Formspree luego)
    setTimeout(() => {
      form.classList.add('hidden');
      successMessage?.classList.remove('hidden');
    }, 1500);
  });
</script>