---
---

<section id="contacto" class="py-32 bg-pc-panel relative border-b border-white/5 overflow-hidden">
  
  <div class="absolute right-0 top-0 w-1/3 h-full bg-pc-cyan/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <div class="reveal">
        <h2 class="font-mono text-4xl md:text-5xl font-bold text-white mb-6">
          INICIAR <br/>
          <span class="text-pc-cyan">PROTOCOLO</span>
        </h2>
        <p class="font-sans text-pc-muted text-lg mb-12 max-w-md">
          Envía los detalles de tu requerimiento. Nuestro equipo analizará tu caso y establecerá contacto en menos de 30 minutos.
        </p>

        <div class="space-y-6 font-mono text-sm">
          <div class="flex items-center gap-4 text-white">
            <svg class="w-6 h-6 text-pc-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Av. Tecnológica 1024, Sector Core</span>
          </div>
          <div class="flex items-center gap-4 text-white">
            <svg class="w-6 h-6 text-pc-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>soporte@nexus.it</span>
          </div>
          <div class="flex items-center gap-4 text-white">
            <svg class="w-6 h-6 text-pc-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>+1 555-0199</span>
          </div>
        </div>
      </div>

      <div class="reveal delay-200">
        <form class="glass-panel p-8 md:p-12 rounded-sm border-t-2 border-t-pc-cyan">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <label class="block font-mono text-xs text-pc-muted uppercase mb-2">ID_Usuario (Nombre)</label>
              <input type="text" class="w-full bg-pc-dark/50 border border-white/10 text-white font-sans px-4 py-3 focus:outline-none focus:border-pc-cyan transition-colors" placeholder="Tu nombre..." />
            </div>
            <div>
              <label class="block font-mono text-xs text-pc-muted uppercase mb-2">Com-Link (Email)</label>
              <input type="email" class="w-full bg-pc-dark/50 border border-white/10 text-white font-sans px-4 py-3 focus:outline-none focus:border-pc-cyan transition-colors" placeholder="tu@email.com" />
            </div>
          </div>
          
          <div class="mb-6">
            <label class="block font-mono text-xs text-pc-muted uppercase mb-2">Categoría del Fallo</label>
            <select class="w-full bg-pc-dark/50 border border-white/10 text-white font-sans px-4 py-3 focus:outline-none focus:border-pc-cyan transition-colors appearance-none cursor-pointer">
              <option>Hardware (No enciende, ruido extraño)</option>
              <option>Software (Pantallazo azul, lentitud)</option>
              <option>Redes (Sin conexión, router)</option>
              <option>Ensamblaje Custom</option>
            </select>
          </div>

          <div class="mb-8">
            <label class="block font-mono text-xs text-pc-muted uppercase mb-2">Log de Error (Detalles)</label>
            <textarea rows="4" class="w-full bg-pc-dark/50 border border-white/10 text-white font-sans px-4 py-3 focus:outline-none focus:border-pc-cyan transition-colors" placeholder="Describe el problema que presenta el equipo..."></textarea>
          </div>

          <button type="button" class="w-full bg-pc-cyan text-pc-dark font-mono font-bold uppercase tracking-widest py-4 hover:bg-white transition-colors duration-300">
            TRANSMITIR_DATOS
          </button>
        </form>
      </div>
      
    </div>
  </div>
</section>