---
---

<section id="features" class="py-32 bg-pc-dark relative border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div class="reveal">
        <h2 class="font-mono text-4xl md:text-5xl font-bold text-white mb-8">
          ¿Por qué confiar en <br/>
          <span class="text-pc-indigo">NEXUS.IT</span>?
        </h2>
        
        <div class="space-y-8">
          
          <div class="flex gap-4">
            <div class="flex-shrink-0 mt-1">
              <div class="w-8 h-8 rounded-full bg-pc-indigo/20 flex items-center justify-center border border-pc-indigo/50">
                <svg class="w-4 h-4 text-pc-indigo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
            </div>
            <div>
              <h3 class="font-mono text-xl font-bold text-white mb-2">Diagnóstico de Precisión</h3>
              <p class="font-sans text-pc-muted text-sm leading-relaxed">Utilizamos software de testeo nivel corporativo para identificar cuellos de botella y fallas de hardware antes de que ocurran.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 mt-1">
              <div class="w-8 h-8 rounded-full bg-pc-indigo/20 flex items-center justify-center border border-pc-indigo/50">
                <svg class="w-4 h-4 text-pc-indigo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
            </div>
            <div>
              <h3 class="font-mono text-xl font-bold text-white mb-2">Transparencia Total</h3>
              <p class="font-sans text-pc-muted text-sm leading-relaxed">Sin sorpresas en la factura. Te explicamos exactamente qué necesita tu equipo y por qué, entregando las piezas defectuosas reemplazadas.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0 mt-1">
              <div class="w-8 h-8 rounded-full bg-pc-indigo/20 flex items-center justify-center border border-pc-indigo/50">
                <svg class="w-4 h-4 text-pc-indigo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
            </div>
            <div>
              <h3 class="font-mono text-xl font-bold text-white mb-2">Garantía Extendida</h3>
              <p class="font-sans text-pc-muted text-sm leading-relaxed">Todos nuestros servicios técnicos cuentan con una garantía de 90 días, asegurando tu tranquilidad y nuestra calidad.</p>
            </div>
          </div>

        </div>
      </div>

      <div class="relative reveal delay-200">
        <!-- Abstract Cyber Graphic -->
        <div class="aspect-square w-full max-w-md mx-auto relative group">
          <div class="absolute inset-0 bg-pc-indigo/20 rounded-full blur-3xl group-hover:bg-pc-cyan/20 transition-colors duration-1000"></div>
          <div class="absolute inset-4 border border-white/10 rounded-full border-dashed animate-[spin_30s_linear_infinite]"></div>
          <div class="absolute inset-12 border border-pc-indigo/30 rounded-full animate-[spin_20s_linear_infinite_reverse]"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-32 h-32 glass-panel rounded-lg flex items-center justify-center shadow-2xl shadow-pc-indigo/20 transform rotate-12 group-hover:rotate-0 transition-transform duration-700">
              <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>