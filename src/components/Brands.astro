<section class="py-10 bg-white border-b border-slate-200">
  <div class="container mx-auto px-6 max-w-6xl">
    <p class="text-center text-sm font-semibold text-slate-400 uppercase tracking-widest mb-6 reveal">Expertos en las principales tecnologías</p>
    
    <div class="flex flex-wrap justify-center items-center gap-10 md:gap-20 opacity-60 grayscale hover:grayscale-0 transition-all duration-500 reveal delay-100">
      <!-- Usamos texto estilizado para simular logotipos sin necesidad de descargar imágenes -->
      <div class="text-2xl font-bold text-slate-800 flex items-center gap-2"><span class="text-blue-500">❖</span> Windows</div>
      <div class="text-2xl font-bold text-slate-800 flex items-center gap-2"><span class="text-slate-900"></span> Apple</div>
      <div class="text-xl font-bold text-slate-800 flex items-center gap-2"><span class="text-green-500">🤖</span> Android</div>
      <div class="text-2xl font-black text-blue-800 italic">CISCO</div>
      <div class="text-2xl font-bold text-slate-600 tracking-tighter">DELL</div>
    </div>
  </div>
</section>