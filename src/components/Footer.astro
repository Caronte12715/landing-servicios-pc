      <!-- Columna 1: Marca -->
      <div class="md:col-span-1">
        <a href="#" class="text-white font-bold text-2xl tracking-tight mb-4 block">Tech<span class="text-blue-500">Soluciones</span></a>
        <p class="text-sm leading-relaxed mb-6">Expertos en soporte técnico, redes y optimización para empresas y hogares. Tu tecnología, en buenas manos.</p>
